# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
# The public base URL of the deployed app (used to build signup links).
# Locally this is http://localhost:3000. On Vercel use your deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The "secret URL" that gates the admin dashboard. Make this long & random.
# The dashboard lives at:  {NEXT_PUBLIC_APP_URL}/a/{ADMIN_SECRET}
# Generate one with:  openssl rand -hex 24
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Supabase ─────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (SendGrid) ─────────────────────────────────────────────────────
# Create an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# The "from" address. With SendGrid Single Sender Verification you can verify
# your own Gmail and send from it without owning a domain.
EMAIL_FROM=james.northrup@gmail.com
EMAIL_FROM_NAME=Stunt Training
# If SENDGRID_API_KEY is empty, the app runs in DRY-RUN ("test") mode: instead
# of sending, every email is captured in the Outbox tab so you can review it and
# click the signup links. Set EMAIL_DRY_RUN=true to force test mode even when a
# SendGrid key is present.
EMAIL_DRY_RUN=

# ── Cron protection ──────────────────────────────────────────────────────
# Vercel Cron calls /api/cron with this bearer token. openssl rand -hex 24
CRON_SECRET=change-me-too

# ── Google Calendar (optional) ───────────────────────────────────────────
# If these are unset, calendar sync is skipped (everything else still works).
# See README "Google Calendar setup" for how to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to write to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# ── Stuntlisting source DB (optional) ────────────────────────────────────
# Read-only MySQL connection used by "Sync from stuntlisting". The app only
# ever runs SELECTs against this database.
STUNTLISTING_DB_HOST=
STUNTLISTING_DB_PORT=3306
STUNTLISTING_DB_USER=
STUNTLISTING_DB_PASSWORD=
STUNTLISTING_DB_NAME=
# "true" to connect over TLS (recommended for RDS).
STUNTLISTING_DB_SSL=true
# The SELECT used to pull contacts. Must return columns aliased `email` and
# (optionally) `name`. Leave unset to use the default (reads a `users` table).
# Example:
#   STUNTLISTING_QUERY=SELECT email, CONCAT_WS(' ', first_name, last_name) AS name FROM members WHERE email > ''
STUNTLISTING_QUERY=
