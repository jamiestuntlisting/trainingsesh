# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
# The public base URL of the deployed app (used to build signup links).
# Locally this is http://localhost:3000. On Vercel use your deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The "secret URL" that gates the admin dashboard. Make this long & random.
# The dashboard lives at:  {NEXT_PUBLIC_APP_URL}/a/{ADMIN_SECRET}
# Generate one with:  openssl rand -hex 24
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Supabase ─────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email + Calendar (Google) ────────────────────────────────────────────
# Email is sent through Gmail, and Calendar sync uses the same connection.
# Create an OAuth client in Google Cloud (see README "Google setup") and put
# the client id/secret here. The refresh token is NOT an env var — you grant it
# once via the in-app "Connect Google" button and it's stored in the database.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional "from" overrides (defaults to the connected Google account):
EMAIL_FROM=james.northrup@gmail.com
EMAIL_FROM_NAME=Stunt Training
# Set to true to force capture-only test mode (emails go to the Outbox, not out)
# even when Google is connected.
EMAIL_DRY_RUN=
# Which calendar to write to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary
# Optional: a refresh token here is used as a fallback if you'd rather not use
# the in-app Connect flow (e.g. minted via `npm run google-auth`).
GOOGLE_REFRESH_TOKEN=

# ── Cron protection ──────────────────────────────────────────────────────
# Vercel Cron calls /api/cron with this bearer token. openssl rand -hex 24
CRON_SECRET=change-me-too

# ── Stuntlisting source DB (optional) ────────────────────────────────────
# Read-only MySQL connection used by "Sync from stuntlisting". The app only
# ever runs SELECTs against this database.
STUNTLISTING_DB_HOST=
STUNTLISTING_DB_PORT=3306
STUNTLISTING_DB_USER=
STUNTLISTING_DB_PASSWORD=
STUNTLISTING_DB_NAME=
# "true" to connect over TLS (recommended for RDS).
STUNTLISTING_DB_SSL=true
# The SELECT used to pull contacts. Must return columns aliased `email` and
# (optionally) `name`. Leave unset to use the default (reads a `users` table).
# Example:
#   STUNTLISTING_QUERY=SELECT email, CONCAT_WS(' ', first_name, last_name) AS name FROM members WHERE email > ''
STUNTLISTING_QUERY=
