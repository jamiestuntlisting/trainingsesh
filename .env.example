# ──────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.
# ──────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────
# The public base URL of the deployed app (used to build signup links).
# Locally this is http://localhost:3000. On Vercel use your deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The "secret URL" that gates the admin dashboard. Make this long & random.
# The dashboard lives at:  {NEXT_PUBLIC_APP_URL}/a/{ADMIN_SECRET}
# Generate one with:  openssl rand -hex 24
ADMIN_SECRET=change-me-to-a-long-random-string

# ── Supabase ─────────────────────────────────────────────────────────────
# From your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server-only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Email (SendGrid) ─────────────────────────────────────────────────────
# Create an API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
# The "from" address. With SendGrid Single Sender Verification you can verify
# your own Gmail and send from it without owning a domain.
EMAIL_FROM=james.northrup@gmail.com
EMAIL_FROM_NAME=Stunt Training
# If SENDGRID_API_KEY is empty, the app runs in DRY-RUN mode and logs emails
# to the server console instead of sending them. Great for local testing.

# ── Cron protection ──────────────────────────────────────────────────────
# Vercel Cron calls /api/cron with this bearer token. openssl rand -hex 24
CRON_SECRET=change-me-too

# ── Google Calendar (optional) ───────────────────────────────────────────
# If these are unset, calendar sync is skipped (everything else still works).
# See README "Google Calendar setup" for how to obtain a refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Which calendar to write to. "primary" = your main calendar.
GOOGLE_CALENDAR_ID=primary

# ── Stuntlisting API (optional) ──────────────────────────────────────────
# Fill these in once you share the API details. The adapter GETs a JSON
# array and maps the configured fields to {email, name}.
STUNTLISTING_API_URL=
STUNTLISTING_API_KEY=
# JSON field names in the API response to read from:
STUNTLISTING_EMAIL_FIELD=email
STUNTLISTING_NAME_FIELD=name
